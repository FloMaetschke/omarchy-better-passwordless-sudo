// The menu entry that install.sh writes into
// ~/.config/omarchy/extensions/omarchy-menu.jsonc.
//
// It overrides Omarchy's stock "setup.security.passwordless-sudo" entry by
// claiming the same id. The stock entry calls omarchy-sudo-passwordless with
// its fixed 15-minute default; this one opens the duration picker.
//
// "checked" queries the expiry timer rather than the sudoers file. That is
// deliberate: the file lives in a directory only root may read, so testing it
// would trigger a password prompt every time the menu opens. systemctl
// is-active needs no privileges at all.

"setup.security.passwordless-sudo": {
  "icon": "󰟵",
  "label": "Passwordless Sudo",
  "checked": "systemctl is-active --quiet omarchy-nopasswd-expire-$USER.timer",
  "action": "omarchy-launch-floating-terminal-with-presentation $HOME/.local/bin/omarchy-better-passwordless-sudo"
},
