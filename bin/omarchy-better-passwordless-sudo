#!/bin/bash

# Passwordless sudo with a duration picker instead of the fixed 15 minutes.
# A separate extension of omarchy-sudo-passwordless; the packaged file in
# /usr/share/omarchy/bin/ is left untouched.
#
# The language follows the locale (LC_ALL > LC_MESSAGES > LANG), falling back to
# English. Translations live in their own files under locale/.

set -e

NOPASSWD_FILE="/etc/sudoers.d/99-omarchy-nopasswd-${USER}"
TIMER_NAME="omarchy-nopasswd-expire-${USER}"

# Offered durations in minutes. The first one is the default; it sits at index 0
# on purpose, so the cursor starts there even without --selected.
MINUTES=(15 60 120 240 480 720 1440)

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SELF="$SELF_DIR/$(basename -- "${BASH_SOURCE[0]}")"

EXT="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
BEGIN='  // >>> omarchy-better-passwordless-sudo >>>'
END='  // <<< omarchy-better-passwordless-sudo <<<'

# --- Language --------------------------------------------------------------

# Where to look for the translations, in order:
#   1. $OMARCHY_BETTER_PASSWORDLESS_SUDO_LOCALE_DIR  (tests, custom installs)
#   2. ../locale next to the script     (running straight from a checkout)
#   3. ~/.local/share/...               (installed by install.sh)
#   4. /usr/share/...                   (installed from a package)
#
# The checkout comes before the installed copies on purpose, so working on a
# clone does not silently pick up translations installed elsewhere.
LOCALE_DIR=""
for _d in \
  "${OMARCHY_BETTER_PASSWORDLESS_SUDO_LOCALE_DIR:-}" \
  "$(dirname "$SELF_DIR")/locale" \
  "$HOME/.local/share/omarchy-better-passwordless-sudo/locale" \
  "/usr/share/omarchy-better-passwordless-sudo/locale"; do
  if [[ -n $_d && -d $_d ]]; then
    LOCALE_DIR="$_d"
    break
  fi
done
if [[ -z $LOCALE_DIR ]]; then
  echo "omarchy-better-passwordless-sudo: locale directory not found" >&2
  exit 1
fi

# "de_AT.UTF-8@euro" becomes "de_AT" and "de". The full form is tried first, so
# zh_TW can have a file of its own, then the bare language code, then English.
_raw="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
_raw="${_raw%%.*}"
_raw="${_raw%%@*}"
_base="${_raw%%_*}"
_base="${_base,,}"

lang="en"
for _cand in "$_raw" "$_base"; do
  if [[ -n $_cand && -f "$LOCALE_DIR/$_cand.sh" ]]; then
    lang="$_cand"
    break
  fi
done

# shellcheck source=/dev/null
source "$LOCALE_DIR/$lang.sh"

# --- Helpers ---------------------------------------------------------------

# Never use a translation as a printf format string: a "%" in some future
# translation would otherwise be read as a placeholder.
fmt() { printf '%s' "${1//\%s/$2}"; }

# Build the labels from MINUTES. Label -> minutes is resolved by index rather
# than by comparing text, so translated units cannot shift anything.
LABELS=()
for m in "${MINUTES[@]}"; do
  if ((m < 60)); then
    LABELS+=("${m} ${T_MIN}")
  else
    LABELS+=("$((m / 60)) ${T_HOUR}")
  fi
done

minutes_for_label() {
  local i
  for i in "${!LABELS[@]}"; do
    if [[ ${LABELS[$i]} == "$1" ]]; then
      echo "${MINUTES[$i]}"
      return 0
    fi
  done
  return 1
}

remaining_human() {
  # --on-active creates a monotonic timer, which leaves NextElapseUSecRealtime
  # empty. list-timers reports the next elapse as a realtime epoch in
  # microseconds instead.
  local next now diff
  next=$(systemctl list-timers "${TIMER_NAME}.timer" --all -o json 2>/dev/null |
    grep -o '"next":[0-9]*' | head -1 | cut -d: -f2)
  [[ -z $next || $next == 0 ]] && return 1
  now=$(date +%s)
  diff=$((next / 1000000 - now))
  ((diff < 0)) && diff=0
  if ((diff >= 3600)); then
    printf '%d %s %d %s' $((diff / 3600)) "$T_HOUR" $(((diff % 3600) / 60)) "$T_MIN"
  else
    printf '%d %s' $(((diff + 59) / 60)) "$T_MIN"
  fi
}

arm_timer() {
  sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null || true
  sudo systemd-run --on-active="${1}m" --timer-property=AccuracySec=1s \
    --unit="$TIMER_NAME" rm "$NOPASSWD_FILE" >/dev/null
}

# --- Menu entry ------------------------------------------------------------

# Written as "$HOME/..." when the script sits in the user's home, so the entry
# stays readable and portable; an absolute path otherwise (a package install).
menu_action_path() {
  case "$SELF" in
  "$HOME"/*) printf '$HOME%s' "${SELF#"$HOME"}" ;;
  *) printf '%s' "$SELF" ;;
  esac
}

# Drop a block written by an earlier run, so nothing lands in there twice.
menu_strip_block() {
  awk -v b="$BEGIN" -v e="$END" '
    index($0, b) { skip = 1; next }
    index($0, e) { skip = 0; next }
    !skip
  ' "$1"
}

menu_setup() {
  local created=0 tmp1 tmp2 last backup
  mkdir -p "$(dirname "$EXT")"
  if [[ ! -f $EXT ]]; then
    printf '{\n}\n' >"$EXT"
    created=1
  fi

  tmp1=$(mktemp)
  tmp2=$(mktemp)
  trap 'rm -f "$tmp1" "$tmp2"' RETURN

  menu_strip_block "$EXT" >"$tmp1"

  # Insert before the final closing brace.
  last=$(grep -n '^[[:space:]]*}[[:space:]]*$' "$tmp1" | tail -1 | cut -d: -f1)
  if [[ -z $last ]]; then
    echo "no closing '}' found in $EXT — check the file by hand" >&2
    return 1
  fi

  head -n $((last - 1)) "$tmp1" >"$tmp2"
  {
    echo "$BEGIN"
    cat <<'ENTRY'
  // Replaces Omarchy's stock entry (a fixed 15 minutes) with a duration picker.
  // "checked" queries the expiry timer rather than the sudoers file: that file
  // lives in a directory only root may read, so testing it would trigger a
  // password prompt every time the menu opens.
ENTRY
    printf '  "setup.security.passwordless-sudo": {"icon":"\U000f07f5","label":"Passwordless Sudo","checked":"systemctl is-active --quiet omarchy-nopasswd-expire-$USER.timer","action":"omarchy-launch-floating-terminal-with-presentation %s"},\n' "$(menu_action_path)"
    echo "$END"
  } >>"$tmp2"
  tail -n +"$last" "$tmp1" >>"$tmp2"

  if cmp -s "$tmp2" "$EXT"; then
    echo "✓ Menu entry already up to date"
  elif ((created)); then
    cat "$tmp2" >"$EXT"
    echo "✓ Menu file created and entry added"
  else
    backup="$EXT.bak.$(date +%s)"
    cp "$EXT" "$backup"
    cat "$tmp2" >"$EXT"
    echo "✓ Menu entry added (backup: $backup)"
  fi

  omarchy menu refresh >/dev/null 2>&1 || true
  echo "✓ Menu reloaded"
  echo
  echo "Open it from: Omarchy menu → Setup → Security → Passwordless Sudo"
}

menu_remove() {
  local tmp backup
  if [[ ! -f $EXT ]] || ! grep -qF "${BEGIN# *}" "$EXT" 2>/dev/null; then
    echo "· No menu entry found"
    return 0
  fi
  tmp=$(mktemp)
  trap 'rm -f "$tmp"' RETURN
  menu_strip_block "$EXT" >"$tmp"
  backup="$EXT.bak.$(date +%s)"
  cp "$EXT" "$backup"
  cat "$tmp" >"$EXT"
  echo "✓ Menu entry removed (backup: $backup)"
  echo "  Omarchy's stock entry with its fixed 15 minutes applies again."
  omarchy menu refresh >/dev/null 2>&1 || true
  echo "✓ Menu reloaded"
}

usage() {
  cat <<USAGE
Usage: $(basename "$SELF") [--setup-menu | --remove-menu]

With no argument, opens the duration picker.

  --setup-menu    add the Omarchy menu entry for the current user, pointing at
                  this copy of the script, and reload the menu
  --remove-menu   remove that menu entry again
  -h, --help      show this text

Run --setup-menu once after installing from a package; install.sh does it for
you when installing from a checkout.
USAGE
}

case "${1:-}" in
--setup-menu)
  menu_setup
  exit $?
  ;;
--remove-menu)
  menu_remove
  exit $?
  ;;
-h | --help)
  usage
  exit 0
  ;;
"") ;;
*)
  echo "unknown argument: $1" >&2
  usage >&2
  exit 2
  ;;
esac

# --- Main ------------------------------------------------------------------

# Safety net: drop a file whose timer is gone (after a reboot, for instance).
if sudo test -f "$NOPASSWD_FILE" && ! systemctl is-active "${TIMER_NAME}.timer" &>/dev/null; then
  sudo rm "$NOPASSWD_FILE"
fi

# The warning and the key hints go into gum's header rather than a preamble of
# their own, keeping the output short; the list height is exactly the number of
# entries.
if sudo test -f "$NOPASSWD_FILE"; then
  left=$(remaining_human || echo "$T_UNKNOWN")
  header="$(fmt "$T_ACTIVE" "$left")
${T_KEYS}

${T_NEW_RUNTIME}"
  options=("${LABELS[@]}" "$T_DISABLE" "$T_CANCEL")
else
  header="${T_WARN}
${T_KEYS}

${T_ENABLE_FOR}"
  options=("${LABELS[@]}" "$T_CANCEL")
fi

# Do NOT redirect stderr here. As soon as stdout is captured by a command
# substitution, gum draws its interface on stderr; redirecting it makes the
# picker invisible while the keys still work.
#
# Cancelling: Esc returns code 1 along with a "nothing selected" line, Ctrl+C
# returns 130. Both become 130 on the way out, because only then does Omarchy's
# presentation wrapper skip its closing screen.
if ! choice=$(gum choose --header "$header" --selected "${LABELS[0]}" \
  --height "${#options[@]}" "${options[@]}"); then
  exit 130
fi

case "$choice" in
"$T_CANCEL" | "")
  exit 130
  ;;
"$T_DISABLE")
  fmt "$T_CHOSEN" "$choice"; echo
  sudo rm "$NOPASSWD_FILE"
  sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null || true
  echo ""
  echo "$T_NOW_OFF"
  ;;
*)
  fmt "$T_CHOSEN" "$choice"; echo
  minutes=$(minutes_for_label "$choice") || {
    echo "unexpected choice: $choice" >&2
    exit 1
  }
  if sudo test -f "$NOPASSWD_FILE"; then
    arm_timer "$minutes"
    echo ""
    fmt "$T_UPDATED" "$choice"; echo
  else
    echo "${USER} ALL=(ALL) NOPASSWD: ALL" | sudo tee "$NOPASSWD_FILE" >/dev/null
    sudo chmod 440 "$NOPASSWD_FILE"
    arm_timer "$minutes"
    echo ""
    fmt "$T_NOW_ON" "$choice"; echo
    echo "$T_REBOOT"
  fi
  ;;
esac
