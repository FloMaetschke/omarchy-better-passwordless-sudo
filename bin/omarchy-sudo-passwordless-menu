#!/bin/bash

# Passwordless sudo mit Zeitauswahl statt fester 15-Minuten-Vorgabe.
# Eigene Erweiterung von omarchy-sudo-passwordless; die Paketdatei in
# /usr/share/omarchy/bin/ bleibt unangetastet.
#
# Sprache folgt dem Locale (LC_ALL > LC_MESSAGES > LANG), Fallback Englisch.

set -e

NOPASSWD_FILE="/etc/sudoers.d/99-omarchy-nopasswd-${USER}"
TIMER_NAME="omarchy-nopasswd-expire-${USER}"

# Angebotene Laufzeiten in Minuten. Die erste ist die Vorauswahl; sie steht
# bewusst an Position 0, damit der Cursor auch ohne --selected dort startet.
MINUTES=(15 60 120 240 480 720 1440)

# --- Sprache ---------------------------------------------------------------

lang="${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}"
lang="${lang%%.*}" # Kodierung abschneiden
lang="${lang%%_*}" # Region abschneiden
lang="${lang,,}"

case "$lang" in
de)
  T_MIN="Min" T_HOUR="Std" T_UNKNOWN="unbekannt"
  T_KEYS="Pfeiltasten wählen, Enter bestätigt, Esc bricht ab."
  T_WARN="WARNUNG: Passwortloses sudo gibt JEDEM Prozess unter deinem Benutzer
vollen Root-Zugriff ohne Passwort — bis die Zeit abläuft."
  T_ENABLE_FOR="Passwordless sudo aktivieren für:"
  T_ACTIVE="Passwordless sudo ist AKTIV (noch %s)."
  T_NEW_RUNTIME="Neue Laufzeit ab jetzt:"
  T_DISABLE="Deaktivieren" T_CANCEL="Abbrechen"
  T_CHOSEN="Gewählt: %s"
  T_NOW_OFF="Passwordless sudo ist DEAKTIVIERT. sudo fragt wieder nach dem Passwort."
  T_UPDATED="Laufzeit aktualisiert: Passwordless sudo schaltet sich in %s ab."
  T_NOW_ON="Passwordless sudo ist AKTIV und schaltet sich in %s automatisch ab."
  T_REBOOT="Hinweis: Nach einem Neustart das Menü erneut aufrufen, um aufzuräumen."
  ;;
es)
  T_MIN="min" T_HOUR="h" T_UNKNOWN="desconocido"
  T_KEYS="Flechas para elegir, Enter confirma, Esc cancela."
  T_WARN="ADVERTENCIA: sudo sin contraseña da a CUALQUIER proceso de tu usuario
acceso root completo sin contraseña — hasta que expire el tiempo."
  T_ENABLE_FOR="Activar sudo sin contraseña durante:"
  T_ACTIVE="sudo sin contraseña está ACTIVO (quedan %s)."
  T_NEW_RUNTIME="Nueva duración a partir de ahora:"
  T_DISABLE="Desactivar" T_CANCEL="Cancelar"
  T_CHOSEN="Elegido: %s"
  T_NOW_OFF="sudo sin contraseña DESACTIVADO. sudo volverá a pedir la contraseña."
  T_UPDATED="Duración actualizada: sudo sin contraseña se desactivará en %s."
  T_NOW_ON="sudo sin contraseña ACTIVO; se desactivará solo en %s."
  T_REBOOT="Nota: tras reiniciar, vuelve a abrir el menú para limpiar."
  ;;
fr)
  T_MIN="min" T_HOUR="h" T_UNKNOWN="inconnu"
  T_KEYS="Flèches pour choisir, Entrée valide, Échap annule."
  T_WARN="AVERTISSEMENT : sudo sans mot de passe donne à TOUT processus de votre
compte un accès root complet sans mot de passe — jusqu'à expiration."
  T_ENABLE_FOR="Activer sudo sans mot de passe pendant :"
  T_ACTIVE="sudo sans mot de passe est ACTIF (encore %s)."
  T_NEW_RUNTIME="Nouvelle durée à partir de maintenant :"
  T_DISABLE="Désactiver" T_CANCEL="Annuler"
  T_CHOSEN="Choisi : %s"
  T_NOW_OFF="sudo sans mot de passe DÉSACTIVÉ. sudo redemandera le mot de passe."
  T_UPDATED="Durée mise à jour : sudo sans mot de passe s'arrêtera dans %s."
  T_NOW_ON="sudo sans mot de passe ACTIF ; il s'arrêtera dans %s."
  T_REBOOT="Note : après un redémarrage, rouvrez le menu pour nettoyer."
  ;;
it)
  T_MIN="min" T_HOUR="h" T_UNKNOWN="sconosciuto"
  T_KEYS="Frecce per scegliere, Invio conferma, Esc annulla."
  T_WARN="ATTENZIONE: sudo senza password dà a QUALSIASI processo del tuo utente
accesso root completo senza password — fino alla scadenza."
  T_ENABLE_FOR="Attiva sudo senza password per:"
  T_ACTIVE="sudo senza password è ATTIVO (ancora %s)."
  T_NEW_RUNTIME="Nuova durata da adesso:"
  T_DISABLE="Disattiva" T_CANCEL="Annulla"
  T_CHOSEN="Scelto: %s"
  T_NOW_OFF="sudo senza password DISATTIVATO. sudo richiederà di nuovo la password."
  T_UPDATED="Durata aggiornata: sudo senza password si disattiverà tra %s."
  T_NOW_ON="sudo senza password ATTIVO; si disattiverà da solo tra %s."
  T_REBOOT="Nota: dopo un riavvio riapri il menu per ripulire."
  ;;
pt)
  T_MIN="min" T_HOUR="h" T_UNKNOWN="desconhecido"
  T_KEYS="Setas para escolher, Enter confirma, Esc cancela."
  T_WARN="AVISO: sudo sem senha dá a QUALQUER processo do seu utilizador
acesso root completo sem senha — até o tempo expirar."
  T_ENABLE_FOR="Ativar sudo sem senha durante:"
  T_ACTIVE="sudo sem senha está ATIVO (faltam %s)."
  T_NEW_RUNTIME="Nova duração a partir de agora:"
  T_DISABLE="Desativar" T_CANCEL="Cancelar"
  T_CHOSEN="Escolhido: %s"
  T_NOW_OFF="sudo sem senha DESATIVADO. sudo voltará a pedir a senha."
  T_UPDATED="Duração atualizada: sudo sem senha desliga em %s."
  T_NOW_ON="sudo sem senha ATIVO; desliga sozinho em %s."
  T_REBOOT="Nota: após reiniciar, abra o menu novamente para limpar."
  ;;
nl)
  T_MIN="min" T_HOUR="u" T_UNKNOWN="onbekend"
  T_KEYS="Pijltjes kiezen, Enter bevestigt, Esc annuleert."
  T_WARN="WAARSCHUWING: sudo zonder wachtwoord geeft ELK proces van je gebruiker
volledige roottoegang zonder wachtwoord — totdat de tijd verstrijkt."
  T_ENABLE_FOR="sudo zonder wachtwoord inschakelen voor:"
  T_ACTIVE="sudo zonder wachtwoord is ACTIEF (nog %s)."
  T_NEW_RUNTIME="Nieuwe looptijd vanaf nu:"
  T_DISABLE="Uitschakelen" T_CANCEL="Annuleren"
  T_CHOSEN="Gekozen: %s"
  T_NOW_OFF="sudo zonder wachtwoord UITGESCHAKELD. sudo vraagt weer om een wachtwoord."
  T_UPDATED="Looptijd bijgewerkt: sudo zonder wachtwoord stopt over %s."
  T_NOW_ON="sudo zonder wachtwoord ACTIEF; stopt vanzelf over %s."
  T_REBOOT="Let op: open het menu na een herstart opnieuw om op te ruimen."
  ;;
*)
  lang="en"
  T_MIN="min" T_HOUR="h" T_UNKNOWN="unknown"
  T_KEYS="Arrow keys to choose, Enter confirms, Esc cancels."
  T_WARN="WARNING: passwordless sudo gives ANY process running as your user
full root access without a password — until the time runs out."
  T_ENABLE_FOR="Enable passwordless sudo for:"
  T_ACTIVE="Passwordless sudo is ACTIVE (%s left)."
  T_NEW_RUNTIME="New duration, starting now:"
  T_DISABLE="Disable" T_CANCEL="Cancel"
  T_CHOSEN="Chosen: %s"
  T_NOW_OFF="Passwordless sudo is DISABLED. sudo will ask for a password again."
  T_UPDATED="Duration updated: passwordless sudo turns off in %s."
  T_NOW_ON="Passwordless sudo is ACTIVE and turns off automatically in %s."
  T_REBOOT="Note: after a reboot, open the menu again to clean up."
  ;;
esac

# --- Hilfsfunktionen -------------------------------------------------------

# Beschriftungen aus MINUTES bauen. Die Zuordnung Label -> Minuten laeuft
# ueber den Index, nicht ueber Textvergleich, damit uebersetzte Einheiten
# nichts verschieben koennen.
LABELS=()
for m in "${MINUTES[@]}"; do
  if ((m < 60)); then
    LABELS+=("${m} ${T_MIN}")
  else
    LABELS+=("$((m / 60)) ${T_HOUR}")
  fi
done

# Uebersetzungen nie als printf-Formatstring verwenden: ein "%" in einer
# kuenftigen Uebersetzung wuerde sonst als Platzhalter gelesen.
fmt() { printf '%s' "${1//\%s/$2}"; }

minutes_for_label() {
  local i
  for i in "${!LABELS[@]}"; do
    if [[ ${LABELS[$i]} == "$1" ]]; then
      echo "${MINUTES[$i]}"
      return 0
    fi
  done
  return 1
}

remaining_human() {
  # --on-active erzeugt einen monotonen Timer, NextElapseUSecRealtime bleibt
  # daher leer. list-timers liefert das naechste Ablaufen als Realtime-Epoche
  # in Mikrosekunden.
  local next now diff
  next=$(systemctl list-timers "${TIMER_NAME}.timer" --all -o json 2>/dev/null |
    grep -o '"next":[0-9]*' | head -1 | cut -d: -f2)
  [[ -z $next || $next == 0 ]] && return 1
  now=$(date +%s)
  diff=$((next / 1000000 - now))
  ((diff < 0)) && diff=0
  if ((diff >= 3600)); then
    printf '%d %s %d %s' $((diff / 3600)) "$T_HOUR" $(((diff % 3600) / 60)) "$T_MIN"
  else
    printf '%d %s' $(((diff + 59) / 60)) "$T_MIN"
  fi
}

arm_timer() {
  sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null || true
  sudo systemd-run --on-active="${1}m" --timer-property=AccuracySec=1s \
    --unit="$TIMER_NAME" rm "$NOPASSWD_FILE" >/dev/null
}

# --- Ablauf ----------------------------------------------------------------

# Sicherheitsnetz: Datei ohne Timer (z. B. nach einem Reboot) wieder entfernen
if sudo test -f "$NOPASSWD_FILE" && ! systemctl is-active "${TIMER_NAME}.timer" &>/dev/null; then
  sudo rm "$NOPASSWD_FILE"
fi

# Der Praesentations-Wrapper hat schon ~13 Logo-Zeilen ausgegeben; ein langer
# Vorspann wuerde das Terminal kurz vor dem Zeichnen der Liste scrollen.
# Deshalb: Schirm leeren, Text in den Header, Listenhoehe exakt auf die
# Zahl der Eintraege.
clear

if sudo test -f "$NOPASSWD_FILE"; then
  left=$(remaining_human || echo "$T_UNKNOWN")
  header="$(fmt "$T_ACTIVE" "$left")
${T_KEYS}

${T_NEW_RUNTIME}"
  options=("${LABELS[@]}" "$T_DISABLE" "$T_CANCEL")
else
  header="${T_WARN}
${T_KEYS}

${T_ENABLE_FOR}"
  options=("${LABELS[@]}" "$T_CANCEL")
fi

# gum beendet sich bei Esc mit Code 1 und der Meldung "nothing selected", bei
# Strg+C mit 130. Beides ist ein Abbruch. Nach aussen wird daraus einheitlich
# 130, denn nur dann laesst der Praesentations-Wrapper den Abschluss-Schirm weg.
# Echte Fehlermeldungen von gum bleiben sichtbar.
gum_err=$(mktemp)
trap 'rm -f "$gum_err"' EXIT
if ! choice=$(gum choose --header "$header" --selected "${LABELS[0]}" \
  --height "${#options[@]}" "${options[@]}" 2>"$gum_err"); then
  grep -v 'nothing selected' "$gum_err" >&2 || true
  exit 130
fi

case "$choice" in
"$T_CANCEL" | "")
  exit 130
  ;;
"$T_DISABLE")
  fmt "$T_CHOSEN" "$choice"; echo
  sudo rm "$NOPASSWD_FILE"
  sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null || true
  echo ""
  echo "$T_NOW_OFF"
  ;;
*)
  fmt "$T_CHOSEN" "$choice"; echo
  minutes=$(minutes_for_label "$choice") || {
    echo "unexpected choice: $choice" >&2
    exit 1
  }
  if sudo test -f "$NOPASSWD_FILE"; then
    arm_timer "$minutes"
    echo ""
    fmt "$T_UPDATED" "$choice"; echo
  else
    echo "${USER} ALL=(ALL) NOPASSWD: ALL" | sudo tee "$NOPASSWD_FILE" >/dev/null
    sudo chmod 440 "$NOPASSWD_FILE"
    arm_timer "$minutes"
    echo ""
    fmt "$T_NOW_ON" "$choice"; echo
    echo "$T_REBOOT"
  fi
  ;;
esac
